# Django Secret Key (Generate a secure key for production)
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production

# Debug mode (Set to False in production)
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# Optional Database URL (Postgres, MySQL, etc.). If omitted, SQLite is used by default.
# DATABASE_URL=postgres://user:password@localhost:5432/nothing_db
